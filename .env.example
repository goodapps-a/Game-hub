# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Online Hokm Server Settings (optional)
DISCONNECT_GRACE_MS=90000
# Optional: set to your Cloudflare Worker custom domain (e.g. https://api.eyvan-hokm.ir)
VITE_ONLINE_API_BASE=""
# Optional: parent cookie domain for cross-subdomain deployments (e.g. .eyvan.ir)
COOKIE_DOMAIN=""
# Optional: central auth session TTL in seconds (default 604800 = 7 days)
AUTH_SESSION_TTL_SEC=604800
# Optional: exact comma-separated allowed CORS origins (never use wildcards like * or *.run.app)
ALLOWED_ORIGINS=""
# Optional: comma-separated trusted reverse proxy IPs allowed to supply X-Forwarded-For (empty = ignore X-Forwarded-For)
TRUSTED_PROXY_IPS=""
# Email delivery configuration (C2: verification & password reset; keep secrets out of git!)
EMAIL_PROVIDER="resend"
RESEND_API_KEY=""
EMAIL_FROM="Eyvan <no-reply@example.com>"
PUBLIC_APP_URL=""
